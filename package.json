{
  "name": "dsh-bili-develop",
  "version": "0.1.6",
  "private": true,
  "description": "DSH 桌面插件：指定工作区的单对话 B站浏览、受控评论及私信",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/a-freshcat/dsh-bili-develop.git" },
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.js", "client.js", "cordis.patch.yml", "src", "python/reader.py", "python/private.py", "python/publishing.py", "python/weekly.py", "python/weekly_card.py", "python/tag_search.py", "python/discovery.py", "python/audio.py",
    "python/vision.py", "python/community.py", "python/model_setup.py", "python/secure_storage.py", "python/privacy_guard.py", "python/relationships.py", "python/requirements.txt", "python/requirements-audio.txt", "README.md", "USER_GUIDE.md", "SECURITY.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "CHANGELOG.md", "docs/performance-0.1.1.md", "docs/performance-0.1.1.json", "docs/dependency-audit.json"],
  "engines": { "node": ">=24.0.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings-general", "@deepseek-ai/dsh-client-ui-workspace"] }
  }
}
